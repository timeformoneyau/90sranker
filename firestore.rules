rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && (request.auth.token.email == "mjreardon62@gmail.com"
              || request.auth.token.admin == true);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── usernames ────────────────────────────────────────────────
    // Public read: required for (a) username-based login before the
    // user is authenticated, and (b) uniqueness check during signup.
    //
    // Create: any signed-in user can claim a username, but the uid
    //   field in the new doc must match their own uid. Admins can
    //   also create (covers admin username-assignment in the panel).
    // Update / Delete: admin only — no self-service username changes.
    match /usernames/{username} {
      allow read:   if true;
      allow create: if isSignedIn()
          && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── users ────────────────────────────────────────────────────
    // Each user manages their own profile doc.
    // Admin can read all users (needed by User Management panel).
    match /users/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ── votes ────────────────────────────────────────────────────
    // Authenticated users can append votes. Admin can read for stats.
    match /votes/{voteId} {
      allow create: if isSignedIn();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── stats ────────────────────────────────────────────────────
    // Public read (leaderboard + recommendation engine use global stats).
    //
    // Writes are scoped per doc to limit the blast radius:
    //   stats/global  — any signed-in user (vote recording is client-side;
    //                   move to Cloud Functions to fully eliminate this).
    //   stats/meta    — any signed-in user (vote counter increments).
    //   stats/user_X  — only the owner (uid matches) or admin.
    //   anything else — admin only.
    match /stats/{docId} {
      allow read: if true;
      allow write: if isSignedIn()
          && (docId == "global"
              || docId == "meta"
              || docId == ("user_" + request.auth.uid)
              || isAdmin());
    }

    // ── movieRequests ────────────────────────────────────────────
    // Authenticated users can submit requests.
    // Admin can read and update status.
    match /movieRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
    }

    // ── adminActions ─────────────────────────────────────────────
    // Written exclusively by Cloud Functions (service account bypasses
    // client rules).  Only admins may read.  Non-admins: no access.
    match /adminActions/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
