rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && (request.auth.token.email == "mjreardon62@gmail.com"
              || request.auth.token.admin == true);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Usernames must be 3-20 chars, letters/numbers/underscore only.
    // The doc ID is stored lowercase; we allow [a-z0-9_] for the ID itself.
    // The users/{uid}.username field uses the same pattern (may include uppercase
    // as entered, normalised to lowercase for the doc ID).
    function isValidUsernameField(name) {
      return name is string
          && name.size() >= 3
          && name.size() <= 20
          && name.matches('^[a-zA-Z0-9_]+$');
    }

    function isValidUsernameDocId(id) {
      return id.size() >= 3
          && id.size() <= 20
          && id.matches('^[a-z0-9_]+$');
    }

    // ── usernames ────────────────────────────────────────────────
    // Public read: required for (a) username-based login before the
    // user is authenticated, and (b) uniqueness check during signup.
    //
    // Create:
    //   - Doc ID must match username format (prevents XSS payloads as doc IDs).
    //   - uid field in the new doc must match the caller's uid (non-admin).
    //   - uid and email must be strings; no extra unexpected fields.
    //   - Admins bypass the uid-ownership check (admin username-assignment).
    // Update / Delete: admin only.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
          && isValidUsernameDocId(username)
          && request.resource.data.uid is string
          && request.resource.data.email is string
          && request.resource.data.keys().hasOnly(['uid', 'email'])
          && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── users ────────────────────────────────────────────────────
    // Each user manages their own profile doc.
    // Admin can read all users (needed by User Management panel).
    // If the write includes a username field, it must pass format validation.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn()
          && (request.auth.uid == uid || isAdmin())
          && (!('username' in request.resource.data)
              || isValidUsernameField(request.resource.data.username));
    }

    // ── votes ────────────────────────────────────────────────────
    // Authenticated users can append votes.
    // Admin can read all votes; users can read their own votes (for matchup history).
    match /votes/{voteId} {
      allow create: if isSignedIn();
      allow read:   if isAdmin() || (isSignedIn() && resource.data.user == request.auth.uid);
      allow update, delete: if false;
    }

    // ── stats ────────────────────────────────────────────────────
    // Public read (leaderboard + recommendation engine use global stats).
    //
    // Writes are scoped per doc to limit the blast radius:
    //   stats/global  — any signed-in user (vote recording is client-side;
    //                   move to Cloud Functions on Blaze plan to lock this down).
    //   stats/meta    — any signed-in user (vote counter increments).
    //   stats/user_X  — only the owner (uid matches) or admin.
    //   anything else — admin only.
    match /stats/{docId} {
      allow read: if true;
      // stats/global and stats/meta are written exclusively by the recordVote /
      // recordToughCallVote Cloud Functions via the admin SDK, which bypasses
      // client rules. Blocking client writes prevents ranking manipulation.
      allow write: if isSignedIn()
          && (docId == ("user_" + request.auth.uid)
              || isAdmin());
    }

    // ── movieRequests ────────────────────────────────────────────
    // Authenticated users can submit requests.
    // Admin can read and update status.
    match /movieRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
    }

    // ── toughCalls ───────────────────────────────────────────────
    // Community-submitted matchups. Public read so the Face/Off page
    // loads for guests. Signed-in users can create (flagging a matchup
    // from the home page) and update (incrementing vote counts).
    match /toughCalls/{tcId} {
      allow read:   if true;
      allow create: if isSignedIn();
      // Vote-count updates handled by recordToughCallVote Cloud Function (admin SDK).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── toughCallVotes ───────────────────────────────────────────
    // One vote doc per user per faceoff (deterministic ID: tcId__uid).
    // Users can only read and create their own vote doc; no edits.
    match /toughCallVotes/{voteId} {
      allow read:   if isSignedIn()
          && voteId.matches('(.*)__' + request.auth.uid);
      allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── adminActions ─────────────────────────────────────────────
    // Written exclusively by Cloud Functions (service account bypasses
    // client rules).  Only admins may read.  Non-admins: no access.
    match /adminActions/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
