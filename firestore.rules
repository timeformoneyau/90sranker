rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && (request.auth.token.email == "mjreardon62@gmail.com"
              || request.auth.token.admin == true);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── usernames ────────────────────────────────────────────────
    // Public read: required for (a) username-based login before the
    // user is authenticated, and (b) uniqueness check during signup.
    // Write: any authenticated user (signup / username overlay).
    match /usernames/{username} {
      allow read:  if true;
      allow write: if isSignedIn();
    }

    // ── users ────────────────────────────────────────────────────
    // Each user manages their own profile doc.
    // Admin can read all users (needed by User Management panel).
    match /users/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ── votes ────────────────────────────────────────────────────
    // Authenticated users can append votes. Admin can read for stats.
    match /votes/{voteId} {
      allow create: if isSignedIn();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── stats ────────────────────────────────────────────────────
    // Public read (coverage diagnostics uses global stats).
    // Admin or authenticated users can write (migration scripts etc.).
    match /stats/{docId} {
      allow read:  if true;
      allow write: if isSignedIn();
    }

    // ── movieRequests ────────────────────────────────────────────
    // Authenticated users can submit requests.
    // Admin can read and update status.
    match /movieRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
    }

    // ── adminActions ─────────────────────────────────────────────
    // Written exclusively by Cloud Functions (service account bypasses
    // client rules).  Only admins may read.  Non-admins: no access.
    match /adminActions/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
